# ── LLM API (en az biri zorunlu, öncelik sırasıyla denenir) ──────────────────

# 1) Claude — https://console.anthropic.com (ücretli, en kaliteli)
ANTHROPIC_API_KEY=

# 2) Groq  — https://console.groq.com      (ÜCRETSİZ, Llama 3.3 70B)
GROQ_API_KEY=

# 3) Gemini — https://aistudio.google.com  (ÜCRETSİZ, Gemini 2.0 Flash)
GEMINI_API_KEY=

# ── Haber Kaynağı ─────────────────────────────────────────────────────────────

# GNews API — https://gnews.io (ÜCRETSİZ, 100 istek/gün, domain kısıtlaması yok)
GNEWS_KEY=

# ── Çıktı ─────────────────────────────────────────────────────────────────────
OUTPUT_DIR=./digests
