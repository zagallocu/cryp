# ── LLM API (en az biri zorunlu, öncelik sırasıyla denenir) ──────────────────

# 1) OpenRouter — https://openrouter.ai  (ÜCRETSİZ — önerilir, Cloudflare yok)
#    Kayıt ol → Keys → Create Key (sk-or- ile başlar)
OPENROUTER_API_KEY=

# 2) Groq  — https://console.groq.com   (ÜCRETSİZ — bazı sunucu IP'leri engellenebilir)
GROQ_API_KEY=

# 3) Gemini — https://aistudio.google.com  (ÜCRETSİZ — günlük kota kısıtlı)
GEMINI_API_KEY=

# 4) Claude — https://console.anthropic.com (ücretli, en kaliteli)
ANTHROPIC_API_KEY=

# ── Haber Kaynağı ─────────────────────────────────────────────────────────────
# GNews API — https://gnews.io (ÜCRETSİZ, 100 istek/gün)
GNEWS_KEY=

# ── Çıktı ─────────────────────────────────────────────────────────────────────
OUTPUT_DIR=./digests
