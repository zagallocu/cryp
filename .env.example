# Claude API anahtarı (zorunlu)
# https://console.anthropic.com adresinden alınabilir
ANTHROPIC_API_KEY=sk-ant-...

# GNews API anahtarı (isteğe bağlı ama önerilir — haber sayısını artırır)
# https://gnews.io adresinden ücretsiz alınabilir (100 istek/gün, domain kısıtlaması yok)
GNEWS_KEY=

# Özet dosyalarının kaydedileceği dizin (isteğe bağlı, varsayılan: .)
OUTPUT_DIR=./digests
