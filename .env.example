# ── LLM API (en az biri zorunlu, öncelik sırasıyla denenir) ──────────────────

# 1) Groq  — https://console.groq.com      (ÜCRETSİZ — önerilir, günde 14.400 istek)
GROQ_API_KEY=

# 2) Gemini — https://aistudio.google.com  (ÜCRETSİZ — günlük kota kısıtlı)
GEMINI_API_KEY=

# 3) Claude — https://console.anthropic.com (ücretli, en kaliteli)
ANTHROPIC_API_KEY=

# ── Haber Kaynağı ─────────────────────────────────────────────────────────────

# GNews API — https://gnews.io (ÜCRETSİZ, 100 istek/gün, domain kısıtlaması yok)
GNEWS_KEY=

# ── Çıktı ─────────────────────────────────────────────────────────────────────
OUTPUT_DIR=./digests
